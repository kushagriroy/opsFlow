DATABASE_URL="postgresql://opsflow:opsflow_dev_only@localhost:5432/opsflow?schema=public"
# Optional integration-test database. Keep this distinct from DATABASE_URL.
TEST_DATABASE_URL="postgresql://opsflow:opsflow_dev_only@localhost:5432/opsflow_test?schema=public"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set true only when the API is behind one trusted reverse proxy.
TRUST_PROXY=false
# Use "none" only for a cross-site HTTPS frontend/API deployment.
COOKIE_SAME_SITE=lax
