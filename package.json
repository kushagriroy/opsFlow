{
  "name": "opsflow",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {"dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"", "dev:api": "npm --workspace apps/api run dev", "dev:web": "npm --workspace apps/web run dev", "build": "npm --workspace apps/api run build && npm --workspace apps/web run build", "test": "npm --workspace apps/api test", "test:integration": "npm --workspace apps/api run test:integration", "test:critical": "npm --workspace apps/api run test:critical"},
  "devDependencies": {"concurrently": "^9.2.1", "typescript": "^5.9.3"}
}
