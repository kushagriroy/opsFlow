generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum WorkStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  RESOLVED
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum Role {
  ADMIN
  TEAM_LEAD
  MEMBER
  VIEWER
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships TeamMembership[]
  assignedItems WorkItem[] @relation("Assignee")
  createdItems WorkItem[] @relation("Creator")
  comments Comment[]
  activity ActivityLog[]
  requestedApprovals Approval[] @relation("Requester")
  assignedApprovals Approval[] @relation("Approver")
  idempotencyRecords IdempotencyRecord[]
}

model Session {
  sid String @id
  data String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
  @@index([expiresAt])
}
model Team {
  id String @id @default(cuid())
  name String @unique
  description String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships TeamMembership[]
  workItems WorkItem[]
}
model TeamMembership {
  id String @id @default(cuid())
  teamId String
  userId String
  role Role @default(MEMBER)
  createdAt DateTime @default(now())
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@index([userId, teamId])
}
model WorkItem {
  id String @id @default(cuid())
  reference String @unique
  title String
  description String @default("")
  status WorkStatus @default(OPEN)
  priority Priority @default(MEDIUM)
  teamId String
  assigneeId String?
  createdById String
  dueAt DateTime?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resolvedAt DateTime?
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignee User? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User @relation("Creator", fields: [createdById], references: [id], onDelete: Restrict)
  comments Comment[]
  activity ActivityLog[]
  approvals Approval[]
  @@index([teamId, status, updatedAt])
  @@index([teamId, priority, status])
  @@index([teamId, assigneeId, status])
  @@index([teamId, dueAt, status])
  @@index([updatedAt])
}
model Comment {
  id String @id @default(cuid())
  workItemId String
  authorId String
  content String
  createdAt DateTime @default(now())
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([workItemId, createdAt])
}
model ActivityLog {
  id String @id @default(cuid())
  workItemId String
  actorId String
  action String
  oldValues Json?
  newValues Json?
  createdAt DateTime @default(now())
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([workItemId, createdAt, id])
}
model Approval {
  id String @id @default(cuid())
  workItemId String
  requestedById String
  approverId String
  status ApprovalStatus @default(PENDING)
  decisionComment String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  requestedBy User @relation("Requester", fields: [requestedById], references: [id], onDelete: Restrict)
  approver User @relation("Approver", fields: [approverId], references: [id], onDelete: Restrict)
  @@index([approverId, status, createdAt])
}
model IdempotencyRecord {
  id String @id @default(cuid())
  userId String
  operation String
  key String
  requestHash String
  resourceId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, operation, key])
  @@index([createdAt])
}
